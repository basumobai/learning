# 手动配置时可复制此文件为 .env，然后替换下方密码与密钥。
# 推荐首次直接运行 bash scripts/install.sh，由安装器生成安全随机值。
# 切勿将 .env 提交到 Git；已有部署不可随意修改 APP_ENCRYPTION_KEY。
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
APP_ORIGIN=http://localhost:3000
# 安装时可选择空闲端口；仅监听本机，不影响其他服务。
WEB_PORT=3000
API_PORT=8080
ELS_ADMIN_USERNAME=admin
ELS_ADMIN_PASSWORD=
# openssl rand -base64 32。须长期保管，否则已加密的 API Key/TOTP 不可恢复。
APP_ENCRYPTION_KEY=
# 可选：服务器PDF目录，只读挂载；默认仓库根目录下 data/pdf。
# LEARNING_PDF_DIR=/www/wwwroot/learning/learning/data/pdf
# 移动部署目录时如需沿用旧卷，可设置原 Compose 项目名。
# COMPOSE_PROJECT_NAME=learning
# v3: enable only after disposable PostgreSQL acceptance; false is application rollback.
LEARNING_V3_SCORING=false
